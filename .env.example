# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VLM_FALLBACK_ENABLED=false
OPENAI_VLM_MODEL=gpt-5.6-luna
OPENAI_VLM_VERIFY_CONF_MAX=0.60

# ChromaDB
CHROMA_PATH=./app/db/chroma
CHROMA_PARENTING_COLLECTION=parenting_guides
CHROMA_HTP_COLLECTION=htp_knowledge

# Database
DATABASE_URL=postgresql+psycopg://gdam_user:your_db_password@localhost:5432/gdam_db

# YOLO / HTP
# YOLO / HTP
YOLO_HTP_HOUSE_WEIGHTS_PATH=ml_models/yolo/house_best.pt
YOLO_HTP_TREE_WEIGHTS_PATH=ml_models/yolo/tree_best.pt
YOLO_HTP_PERSON_WEIGHTS_PATH=ml_models/yolo/person_best.pt
YOLO_HTP_MODEL_NAME_HOUSE=yolov8m_house
YOLO_HTP_MODEL_NAME_TREE=yolov8m_tree
YOLO_HTP_MODEL_NAME_PERSON=yolov8m_person
YOLO_HTP_IMAGE_SIZE=640
YOLO_HTP_CONF_THRESHOLD=0.25
YOLO_HTP_FALLBACK_ENABLED=true

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
