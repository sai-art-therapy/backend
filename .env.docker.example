# Local Docker only. Do not commit a real .env.docker file.
OPENAI_API_KEY=
POSTGRES_PASSWORD=change-this-local-database-password
JWT_SECRET_KEY=change-this-local-jwt-secret-at-least-32-characters

OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_VLM_FALLBACK_ENABLED=false
OPENAI_VLM_MODEL=gpt-5.6-luna
OPENAI_VLM_VERIFY_CONF_MAX=0.60

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
YOLO_HTP_FALLBACK_ENABLED=true

# Required only when testing Google login locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
